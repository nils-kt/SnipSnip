<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SnipSnip</AssemblyName>
    <RootNamespace>SnipSnip</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <!-- DPI-Einstellungen stehen bewusst im Manifest (WPF-App) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <Product>SnipSnip</Product>
    <Description>Schönes Snipping Tool mit Editor, Zensur und Upload</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
