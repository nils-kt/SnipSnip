<Window x:Class="SnipSnip.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" Title="SnipSnip Auswahl"
        Left="0" Top="0" Width="100" Height="100">
    <Grid x:Name="Root">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False"/>

        <Canvas x:Name="Fx" IsHitTestVisible="False">
            <Line x:Name="CrossH" Stroke="#C8FFFFFF" StrokeThickness="1" StrokeDashArray="4 3"/>
            <Line x:Name="CrossV" Stroke="#C8FFFFFF" StrokeThickness="1" StrokeDashArray="4 3"/>
            <Polyline x:Name="LassoLine" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                      StrokeLineJoin="Round" Visibility="Collapsed"/>
            <Rectangle x:Name="SelGlow" Stroke="#664F8CFF" StrokeThickness="6" Visibility="Collapsed"/>
            <Rectangle x:Name="SelBorder" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed"/>

            <Border x:Name="SizeTag" Background="#EE1E1E23" CornerRadius="5" Padding="7,3" Visibility="Collapsed"
                    BorderBrush="#30FFFFFF" BorderThickness="1">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
            </Border>

            <!-- Lupe -->
            <Border x:Name="Loupe" Width="142" Background="#F01E1E23" CornerRadius="10" Padding="3"
                    BorderBrush="#40FFFFFF" BorderThickness="1" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel>
                    <Border Width="136" Height="136" CornerRadius="7" ClipToBounds="True">
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,136,136" RadiusX="7" RadiusY="7"/>
                        </Border.Clip>
                        <Grid>
                            <Rectangle x:Name="LoupeImg"/>
                            <Path Stroke="#50FFFFFF" StrokeThickness="1" Data="M68,0 V64 M68,72 V136 M0,68 H64 M72,68 H136"/>
                            <Rectangle Width="10" Height="10" Stroke="White" StrokeThickness="1.5"
                                       HorizontalAlignment="Left" VerticalAlignment="Top" Margin="63,63,0,0"/>
                        </Grid>
                    </Border>
                    <Grid Margin="4,5,4,3">
                        <TextBlock x:Name="LoupePos" Foreground="#FFB4B4BE" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border x:Name="LoupeSwatch" Width="11" Height="11" CornerRadius="2" BorderBrush="#60FFFFFF"
                                    BorderThickness="1" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LoupeHex" Foreground="White" FontSize="11" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>

        <ContentControl x:Name="ToolbarHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Margin="0,18,0,0" Focusable="False"/>
    </Grid>
</Window>
