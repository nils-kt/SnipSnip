<Window x:Class="SnipSnip.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SnipSnip"
        Title="SnipSnip Studio" Width="1480" Height="920" MinWidth="1100" MinHeight="660"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico" AllowDrop="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="RadioButton" x:Key="Seg" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,3,3"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Dim">
            <Setter Property="Foreground" Value="{StaticResource FgDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <!-- ================= Kopfzeile ================= -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconVideo}" Content="Neu"
                                ToolTip="Neue Videoaufnahme  (Strg+N)" Click="New_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}"
                                ToolTip="Projekt, Projektdatei oder Video öffnen  (Strg+O)" Click="Open_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconLayers}" Content="Projekte"
                                ToolTip="Alle Projekte anzeigen" Click="Projects_Click"/>
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconSave}"
                                ToolTip="Projekt als Datei speichern (.snipsnip)  (Strg+Umschalt+S)" Click="SaveProjectFile_Click"/>
                        <Border Style="{StaticResource VSep}"/>
                        <Grid VerticalAlignment="Center" Margin="4,0,0,0">
                            <TextBlock x:Name="ProjectName" VerticalAlignment="Center" FontWeight="SemiBold" Cursor="Hand"
                                       ToolTip="Klicken zum Umbenennen" MouseLeftButtonDown="ProjectName_Click"/>
                            <TextBox x:Name="ProjectNameBox" Style="{StaticResource DarkText}" MinWidth="220" Visibility="Collapsed"
                                     KeyDown="ProjectNameBox_KeyDown" LostKeyboardFocus="ProjectNameBox_LostFocus"/>
                        </Grid>
                        <TextBlock x:Name="SaveState" Style="{StaticResource Dim}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <StackPanel x:Name="AspectBar" Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconSearch}" ToolTip="Befehle  (Strg+K)" Click="Palette_Click"/>
                        <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconUndo}" ToolTip="Rückgängig  (Strg+Z)" Click="Undo_Click"/>
                        <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconRedo}" ToolTip="Wiederholen  (Strg+Y)" Click="Redo_Click"/>
                        <Border Style="{StaticResource VSep}"/>
                        <Button Style="{StaticResource AccentButton}" Tag="{StaticResource IconExport}" Content="Exportieren"
                                ToolTip="Exportieren, kopieren oder hochladen  (Strg+E)" Click="Export_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= Zeitleiste ================= -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0" Padding="10,6,10,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconPlay}"
                                    ToolTip="Abspielen / Pause  (Leertaste)" Click="Play_Click"/>
                            <TextBlock x:Name="TimeText" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Margin="6,0,10,0"/>
                            <Border Style="{StaticResource VSep}"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconSplit}" Content="Teilen"
                                    ToolTip="Clip an der Abspielposition teilen  (S)" Click="Split_Click"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}" Content="Entfernen"
                                    ToolTip="Markierten Clip entfernen/wiederherstellen bzw. Segment löschen  (Entf)" Click="Delete_Click"/>
                            <Border Style="{StaticResource VSep}"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconZoom}" Content="Zoom"
                                    ToolTip="Zoom an der Abspielposition hinzufügen  (Z)" Click="AddZoom_Click"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconMask}" Content="Maske"
                                    ToolTip="Maske für sensible Daten hinzufügen  (M)" Click="AddMask_Click"/>
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconText}" Content="Text"
                                    ToolTip="Titel, Untertitel, Hinweis oder Bauchbinde hinzufügen  (T)" Click="AddText_Click"/>
                            <Button x:Name="AddLayoutBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconWebcam}" Content="Layout"
                                    ToolTip="Kamera-Layout für einen Abschnitt  (L)" Click="AddLayout_Click"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock x:Name="OutInfo" Style="{StaticResource Dim}" Margin="0,0,8,0"/>
                            <Button x:Name="MuteBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconSpeaker}" ToolTip="Vorschau stumm" Click="Mute_Click"/>
                        </StackPanel>
                        <Border/>
                    </DockPanel>
                    <local:TimelineControl x:Name="Timeline"/>
                </StackPanel>
            </Border>

            <!-- ================= Seitenleiste ================= -->
            <Border DockPanel.Dock="Right" Width="368" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                        <WrapPanel x:Name="Tabs" HorizontalAlignment="Center"/>
                    </Border>
                    <ScrollViewer x:Name="SideScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="Side" Margin="18,6,18,24"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ================= Vorschau ================= -->
            <Grid x:Name="PreviewHost" Background="#FF0C0C0E" ClipToBounds="True">
                <Image x:Name="Preview" Stretch="Uniform" Margin="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Canvas x:Name="PreviewOverlay"/>
                <TextBlock x:Name="PreviewHint" Style="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
            </Grid>
        </DockPanel>

        <!-- ================= Export-Dialog ================= -->
        <Border x:Name="ExportPanel" Background="#B00C0C0E" Visibility="Collapsed">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24,20" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}" Click="CloseExport_Click"/>
                        <TextBlock Text="Exportieren" FontSize="20" FontWeight="SemiBold"/>
                    </DockPanel>
                    <StackPanel x:Name="ExportOptionsPanel" Margin="0,8,0,0"/>
                    <TextBlock x:Name="ExportInfo" Style="{StaticResource Dim}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <StackPanel x:Name="ExportProgress" Visibility="Collapsed" Margin="0,14,0,0">
                        <ProgressBar x:Name="ExportBar" Height="6" Maximum="1" Foreground="{StaticResource AccentBrush}" Background="#22FFFFFF" BorderThickness="0"/>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="Abbrechen" Click="CancelExport_Click"/>
                            <TextBlock x:Name="ExportStatus" Style="{StaticResource Dim}"/>
                        </DockPanel>
                    </StackPanel>
                    <WrapPanel x:Name="ExportButtons" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconImage}" Content="Standbild"
                                ToolTip="Aktuelles Bild als PNG speichern" Click="ExportStill_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCopy}" Content="Kopieren" Click="ExportCopy_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconUpload}" Content="Hochladen" Click="ExportUpload_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource AccentButton}" Tag="{StaticResource IconSave}" Content="Speichern unter …" Click="ExportSave_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= Befehlspalette ================= -->
        <Border x:Name="PalettePanel" Background="#800C0C0E" Visibility="Collapsed" MouseLeftButtonDown="PaletteBackdrop_Click">
            <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Width="520" Margin="0,90,0,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="6" Opacity="0.6"/>
                </Border.Effect>
                <StackPanel>
                    <TextBox x:Name="PaletteBox" Style="{StaticResource DarkText}" FontSize="15" TextChanged="PaletteBox_TextChanged"
                             PreviewKeyDown="PaletteBox_KeyDown"/>
                    <ListBox x:Name="PaletteList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgBrush}"
                             MaxHeight="360" Margin="0,6,0,0" MouseDoubleClick="PaletteList_DoubleClick"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
