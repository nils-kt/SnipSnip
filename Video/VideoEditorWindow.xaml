<Window x:Class="SnipSnip.VideoEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipSnip – Video" Width="1180" Height="800" MinWidth="900" MinHeight="560"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}" WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico" AllowDrop="True" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="BarLabel">
            <Setter Property="Foreground" Value="{StaticResource FgDimBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="RadioButton" x:Key="Seg" BasedOn="{StaticResource ToolToggle}">
            <Setter Property="Padding" Value="9,5"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ================= Hauptleiste ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconScissors}" Content="Neu"
                            ToolTip="Neue Aufnahme  (Strg+N)" Click="New_Click"/>
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}"
                            ToolTip="Video öffnen  (Strg+O)" Click="Open_Click"/>
                    <Border Style="{StaticResource VSep}"/>
                    <Button x:Name="TrimStartBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconTrimStart}" Content="Anfang"
                            ToolTip="Alles vor der Abspielposition entfernen  (A)" Click="TrimStart_Click"/>
                    <Button x:Name="SplitBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconSplit}" Content="Teilen"
                            ToolTip="An der Abspielposition teilen  (S)" Click="Split_Click"/>
                    <Button x:Name="TrimEndBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconTrimEnd}" Content="Ende"
                            ToolTip="Alles nach der Abspielposition entfernen  (E)" Click="TrimEnd_Click"/>
                    <Button x:Name="RemoveBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}" Content="Abschnitt"
                            ToolTip="Markierten Abschnitt entfernen / wiederherstellen  (Entf)" Click="Remove_Click"/>
                    <Border Style="{StaticResource VSep}"/>
                    <Button x:Name="UndoBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconUndo}"
                            ToolTip="Rückgängig  (Strg+Z)" Click="Undo_Click"/>
                    <Button x:Name="RedoBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconRedo}"
                            ToolTip="Wiederholen  (Strg+Y)" Click="Redo_Click"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconCopy}" Content="Kopieren"
                            ToolTip="Videodatei in die Zwischenablage (z. B. für Discord, Teams, Explorer)  (Strg+C)" Click="Copy_Click"/>
                    <Button x:Name="SaveBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconSave}" Content="Speichern"
                            ToolTip="Speichern unter …  (Strg+S)" Click="Save_Click"/>
                    <Button x:Name="UploadBtn" Style="{StaticResource AccentButton}" Tag="{StaticResource IconUpload}"
                            Content="Hochladen" Click="Upload_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Export-Optionen ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="14,4" MinHeight="42">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Format" Style="{StaticResource BarLabel}"/>
                <RadioButton x:Name="FmtMp4" GroupName="Fmt" Style="{StaticResource Seg}" Tag="{StaticResource IconVideo}" Content="MP4" Checked="Options_Changed"/>
                <RadioButton x:Name="FmtGif" GroupName="Fmt" Style="{StaticResource Seg}" Tag="{StaticResource IconGif}" Content="GIF" Checked="Options_Changed"/>
                <Border Style="{StaticResource VSep}"/>
                <TextBlock Text="Größe" Style="{StaticResource BarLabel}"/>
                <RadioButton x:Name="Size100" GroupName="Size" Style="{StaticResource Seg}" Content="100 %" Checked="Options_Changed"/>
                <RadioButton x:Name="Size75" GroupName="Size" Style="{StaticResource Seg}" Content="75 %" Checked="Options_Changed"/>
                <RadioButton x:Name="Size50" GroupName="Size" Style="{StaticResource Seg}" Content="50 %" Checked="Options_Changed"/>
                <Border Style="{StaticResource VSep}"/>
                <ToggleButton x:Name="AudioToggle" Style="{StaticResource ToolToggle}" Tag="{StaticResource IconSpeaker}" Content="Ton"
                              ToolTip="Tonspur exportieren" Click="Options_Changed"/>
                <StackPanel x:Name="GifPanel" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Bilder/s" Style="{StaticResource BarLabel}" Margin="4,0,8,0"/>
                    <RadioButton x:Name="Fps10" GroupName="GifFps" Style="{StaticResource Seg}" Content="10" Checked="Options_Changed"/>
                    <RadioButton x:Name="Fps15" GroupName="GifFps" Style="{StaticResource Seg}" Content="15" Checked="Options_Changed"/>
                    <RadioButton x:Name="Fps24" GroupName="GifFps" Style="{StaticResource Seg}" Content="24" Checked="Options_Changed"/>
                </StackPanel>
                <TextBlock x:Name="OutInfo" Style="{StaticResource BarLabel}" Margin="14,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- ================= Statusleiste ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <TextBlock x:Name="StatusInfo" DockPanel.Dock="Right" Foreground="{StaticResource FgDimBrush}" FontSize="12"/>
                <TextBlock x:Name="StatusHint" Foreground="{StaticResource FgDimBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Text="Leertaste = Abspielen  ·  ← → = Bild für Bild (Umschalt: 1 s)  ·  Klick auf die Zeitleiste = springen &amp; Abschnitt markieren"/>
            </DockPanel>
        </Border>

        <!-- ================= Transport + Zeitleiste ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="14,8,14,12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="PlayBtn" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="{StaticResource IconPlay}"
                            ToolTip="Abspielen / Pause  (Leertaste)" Click="Play_Click"/>
                    <Button x:Name="MuteBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconSpeaker}"
                            ToolTip="Vorschau stumm schalten" Click="Mute_Click"/>
                    <TextBlock x:Name="TimeText" VerticalAlignment="Center" Margin="8,0,0,0" FontFamily="Consolas" FontSize="13"/>
                </DockPanel>
                <Grid x:Name="Timeline" Height="72" Background="#FF101013" ClipToBounds="True" Cursor="Hand">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="TimelineClip" RadiusX="8" RadiusY="8"/>
                    </Grid.Clip>
                    <UniformGrid x:Name="Thumbs" Rows="1" Opacity="0.85"/>
                    <Canvas x:Name="SegLayer"/>
                    <Canvas x:Name="HeadLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="Playhead" Width="2" Height="72" Fill="White">
                            <Rectangle.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                        <Path x:Name="PlayheadKnob" Data="M0,0 H12 V7 L6,12 L0,7 Z" Fill="White"/>
                    </Canvas>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ================= Vorschau ================= -->
        <Grid Background="#FF0C0C0E">
            <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True"
                          Stretch="Uniform" Margin="24"/>
            <Image x:Name="Poster" Stretch="Uniform" Margin="24" Visibility="Collapsed"/>

            <!-- Fortschritt beim Exportieren -->
            <Border x:Name="BusyPanel" Background="#CC0C0C0E" Visibility="Collapsed">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22,18" Width="380"
                        HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="BusyTitle" Text="Exportiere …" FontSize="15" FontWeight="SemiBold"/>
                        <ProgressBar x:Name="BusyBar" Height="6" Margin="0,12,0,6" Maximum="1"
                                     Foreground="{StaticResource AccentBrush}" Background="#22FFFFFF" BorderThickness="0"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="Abbrechen" Click="CancelBusy_Click"/>
                            <TextBlock x:Name="BusyText" Foreground="{StaticResource FgDimBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </DockPanel>
</Window>
