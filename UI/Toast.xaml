<Window x:Class="SnipSnip.Toast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="Height" Width="400" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True">
    <Border x:Name="Card" Margin="16" Background="#F7202026" CornerRadius="12" BorderBrush="#30FFFFFF"
            BorderThickness="1" Padding="12" MouseLeftButtonUp="Card_Click">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.55"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ThumbBox" Width="88" Height="62" CornerRadius="7" Margin="0,0,12,0"
                    VerticalAlignment="Top" Background="#FF111114" BorderBrush="#25FFFFFF" BorderThickness="1">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,88,62" RadiusX="7" RadiusY="7"/>
                </Border.Clip>
                <Image x:Name="Thumb" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                <TextBlock x:Name="MessageText" FontSize="12" Foreground="#FFB4B4BE" TextWrapping="Wrap"
                           Margin="0,3,0,0" MaxHeight="52" TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="3" Margin="0,9,0,0"
                             Visibility="Collapsed" Foreground="{StaticResource AccentBrush}"
                             Background="#22FFFFFF" BorderThickness="0"/>
                <WrapPanel x:Name="Buttons" Margin="-2,8,0,0"/>
            </StackPanel>

            <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}"
                    Padding="3" Margin="6,-4,-4,0" VerticalAlignment="Top" Click="Close_Click" ToolTip="Schließen"/>
        </Grid>
    </Border>
</Window>
