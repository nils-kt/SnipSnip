<Window x:Class="SnipSnip.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipSnip – Projekte" Width="980" Height="680" MinWidth="620" MinHeight="400"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico" UseLayoutRounding="True" AllowDrop="True">
    <DockPanel Margin="20,16,20,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="200" Margin="0,0,8,0">
                    <TextBox x:Name="SearchBox" Style="{StaticResource DarkText}" ToolTip="Projekte durchsuchen" TextChanged="Search_TextChanged"/>
                    <TextBlock x:Name="SearchHint" Text="Suchen …" IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{StaticResource FgDimBrush}"/>
                </Grid>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}" Content="Projektdatei öffnen …"
                        ToolTip="Eine .snipsnip-Datei öffnen" Click="OpenFile_Click"/>
                <Button Style="{StaticResource AccentButton}" Tag="{StaticResource IconVideo}" Content="Neue Aufnahme" Margin="6,0,0,0" Click="New_Click"/>
            </StackPanel>
            <TextBlock Text="Projekte" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock x:Name="CountText" Foreground="{StaticResource FgDimBrush}" VerticalAlignment="Center" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel x:Name="RenamePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
                    <TextBox x:Name="RenameBox" Style="{StaticResource DarkText}" Width="240" KeyDown="RenameBox_KeyDown"/>
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCheck}" ToolTip="Übernehmen (Enter)" Click="RenameOk_Click"/>
                </StackPanel>
                <Button x:Name="OpenBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconOpenExt}" Content="Öffnen" Click="Open_Click"/>
                <Button x:Name="RenameBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconEdit}" Content="Umbenennen" Click="Rename_Click"/>
                <Button x:Name="SaveBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconSave}" Content="Als Datei speichern …"
                        ToolTip="Projekt als eine .snipsnip-Datei sichern oder weitergeben" Click="SaveFile_Click"/>
                <Button x:Name="FolderBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}" ToolTip="Im Explorer zeigen" Click="Folder_Click"/>
                <Button x:Name="DeleteBtn" Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}" ToolTip="In den Papierkorb verschieben" Click="Delete_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{StaticResource FgBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8"
                         MouseDoubleClick="List_DoubleClick" SelectionChanged="List_SelectionChanged" KeyDown="List_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="212" Margin="4,4,4,8">
                                <Border CornerRadius="8" Height="119" Background="#FF101014" ClipToBounds="True">
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="2,7,2,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                <TextBlock Text="{Binding Info}" Foreground="{StaticResource FgDimBrush}" FontSize="12" Margin="2,2,2,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Foreground="{StaticResource FgDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" Margin="40">
                    Noch keine Projekte. Jede Videoaufnahme wird automatisch zum Projekt –
                    oder öffne eine .snipsnip-Datei.
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</Window>
