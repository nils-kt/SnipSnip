<Window x:Class="SnipSnip.FfmpegSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipSnip – FFmpeg einrichten" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico" UseLayoutRounding="True" Topmost="True">
    <StackPanel Margin="24,20,24,18">
        <StackPanel Orientation="Horizontal">
            <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                <Path Width="24" Height="24" Data="{StaticResource IconVideo}" Stroke="{StaticResource AccentTextBrush}"
                      StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Viewbox>
            <TextBlock Text="Für Videos wird FFmpeg benötigt" FontSize="19" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgDimBrush}" Margin="0,12,0,0" LineHeight="20">
            SnipSnip nutzt das freie Programm <Run Foreground="{StaticResource FgBrush}">FFmpeg</Run> zum Kodieren, Schneiden und für GIFs.
            Es kann einmalig automatisch heruntergeladen werden (offizieller Build von github.com/BtbN/FFmpeg-Builds,
            per SHA-256 geprüft) und wird nur für SnipSnip in <Run x:Name="TargetRun" Foreground="{StaticResource FgBrush}"/> abgelegt.
        </TextBlock>

        <Border x:Name="ProgressBox" Visibility="Collapsed" Margin="0,16,0,0">
            <StackPanel>
                <ProgressBar x:Name="Bar" Height="6" Maximum="1" Foreground="{StaticResource AccentBrush}" Background="#22FFFFFF" BorderThickness="0"/>
                <TextBlock x:Name="ProgressText" Foreground="{StaticResource FgDimBrush}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <TextBlock Foreground="{StaticResource FgDimBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0">
            Alternativ: <Run FontFamily="Consolas" Foreground="{StaticResource FgBrush}">winget install Gyan.FFmpeg</Run> im Terminal ausführen
            oder eine vorhandene ffmpeg.exe auswählen.
        </TextBlock>

        <DockPanel Margin="0,20,0,0">
            <Button x:Name="BrowseBtn" DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}"
                    Content="ffmpeg.exe wählen …" Click="Browse_Click"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelBtn" Style="{StaticResource IconButton}" Content="Abbrechen" Padding="14,7" Click="Cancel_Click"/>
                <Button x:Name="DownloadBtn" Style="{StaticResource AccentButton}" Tag="{StaticResource IconSave}" Padding="16,7"
                        Content="Herunterladen" Click="Download_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
